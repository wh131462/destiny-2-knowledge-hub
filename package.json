{
  "name": "destiny-2-knowledge-hub-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate-content.js",
    "docs:generate": "node scripts/generate-knowledge-base.js",
    "manifest:sync": "node scripts/sync-manifest.js",
    "manifest:sync:components": "node scripts/sync-manifest.js --components=DestinyClassDefinition,DestinyDamageTypeDefinition,DestinyStatDefinition,DestinyActivityTypeDefinition,DestinyInventoryItemDefinition,DestinySandboxPerkDefinition,DestinyItemCategoryDefinition,DestinyEquipmentSlotDefinition,DestinyPlugSetDefinition,DestinySocketCategoryDefinition,DestinySocketTypeDefinition,DestinyActivityDefinition,DestinyVendorDefinition,DestinyEquipableItemSetDefinition,DestinyRewardItemListDefinition,DestinySackRewardItemListDefinition,DestinyRewardMappingDefinition,DestinyUnlockDefinition,DestinyUnlockValueDefinition",
    "manifest:sync:zh": "node scripts/sync-manifest.js --locale=zh-chs --components=DestinyInventoryItemDefinition,DestinyActivityDefinition,DestinySandboxPerkDefinition,DestinyVendorDefinition && node scripts/extract-manifest-locales.js",
    "manifest:sync:knowledge": "npm run manifest:sync:components && npm run manifest:normalize && npm run manifest:link",
    "manifest:normalize": "node scripts/normalize-manifest.js && node scripts/normalize-manifest-components.js",
    "manifest:normalize-components": "node scripts/normalize-manifest-components.js",
    "manifest:link": "node scripts/link-content-to-manifest.js",
    "audit:builds": "node scripts/audit-curated-builds.js",
    "coverage": "node scripts/coverage-report.js",
    "check": "npm run validate && npm run audit:builds && npm test && npm run docs:generate && npm run build"
  }
}
